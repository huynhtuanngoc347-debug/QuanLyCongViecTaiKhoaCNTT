{
  "name": "@khoa/api",
  "version": "1.0.0",
  "private": true,
  "description": "API NestJS dùng chung cho web và app di động",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/core.test.js dist-test/regression.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "mssql": "^11.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^4.5.0"
  },
  "devDependencies": {
    "@khoa/shared": "1.0.0",
    "@nestjs/cli": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/mssql": "^9.1.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3"
  }
}
