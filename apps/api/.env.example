# Sao chép tệp này thành apps/api/.env rồi sửa cho máy của bạn.
PORT=5080

# ---- SQL Server ----
# Cách 1 (khuyên dùng): tài khoản SQL (ví dụ sa). Cần bật "SQL Server and Windows Authentication mode"
# và bật TCP/IP trong SQL Server Configuration Manager.
DB_DRIVER=tedious
DB_SERVER=localhost
# SQL Express: DB_INSTANCE=SQLEXPRESS (và bật dịch vụ SQL Server Browser), hoặc ghi rõ DB_PORT=1433
DB_INSTANCE=
DB_PORT=
DB_NAME=QLCongViecKhoaCNTT
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Cách 2: đăng nhập Windows (Trusted_Connection) — cần ODBC Driver 17/18 for SQL Server
# và gói msnodesqlv8 (npm cài tự động trên Windows).
# DB_DRIVER=msnodesqlv8
# DB_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=localhost;Database=QLCongViecKhoaCNTT;Trusted_Connection=yes;TrustServerCertificate=yes;

# ---- Đăng nhập (JWT) ----
# Chuỗi ngẫu nhiên dài ≥ 32 ký tự. Đổi khóa này sẽ đăng xuất mọi người.
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# true khi chạy qua HTTPS
COOKIE_SECURE=

# Chỉ cần khi giao diện chạy ở địa chỉ khác API (phân tách bằng dấu phẩy)
CORS_ORIGINS=

# Thư mục lưu tệp nộp kết quả (khi bật kho S3 bên dưới: chỉ là chỗ lưu tạm)
UPLOADS_PATH=App_Data/uploads

# ---- Gửi email (mã quên mật khẩu) ----
# Gmail: bật Xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" (16 ký tự) tại https://myaccount.google.com/apppasswords
# Bỏ trống SMTP_HOST hoặc SMTP_PASS: không gửi mail, mã in ra cửa sổ chạy API (chỉ để thử trên máy).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- Kho tệp ngoài chuẩn S3 (tùy chọn) ----
# Bỏ trống S3_BUCKET = lưu trên đĩa như cũ. Tệp cũ trên đĩa: chạy node tools/upload-to-s3.mjs để chuyển lên.
# Backblaze B2: S3_ENDPOINT=https://s3.<vùng>.backblazeb2.com, S3_REGION=<vùng> (ví dụ us-west-004)
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Nhắc hạn + tạo bản nháp lặp lại (phút); 0 = tắt
REMINDER_INTERVAL_MINUTES=60
